@model CartDto
@{
    ViewData["Title"] = "Panier";
}

<div class="page-container py-5">
    <div class="page-header">
        <h1>Votre panier</h1>
    </div>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (Model.Items.Count == 0)
    {
        <div class="empty-state">
            <p>Votre panier est vide.</p>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary mt-2">Parcourir le catalogue</a>
        </div>
    }
    else
    {
        <div class="table-responsive mb-4">
            <table class="table table-clean align-middle">
                <thead>
                    <tr>
                        <th>Produit</th>
                        <th>Prix unitaire</th>
                        <th>Quantité</th>
                        <th>Sous-total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-medium">@item.ProductName</td>
                            <td>@item.UnitPrice.ToString("C")</td>
                            <td>
                                <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm" style="width: 4.5rem;" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Mettre à jour</button>
                                </form>
                            </td>
                            <td class="fw-semibold">@item.Subtotal.ToString("C")</td>
                            <td class="text-end">
                                <form asp-controller="Cart" asp-action="Remove" method="post">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0">Retirer</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-end">
            <div class="form-card" style="max-width: 320px;">
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Total</span>
                    <span class="fs-4 fw-bold" style="font-family: var(--font-display);">@Model.Total.ToString("C")</span>
                </div>
                <form asp-controller="Checkout" asp-action="Create" method="post">
                    <button type="submit" class="btn btn-primary w-100 btn-lg">Passer la commande</button>
                </form>
            </div>
        </div>
    }
</div>
