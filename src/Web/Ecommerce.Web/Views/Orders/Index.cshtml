@model IReadOnlyList<OrderDto>
@{
    ViewData["Title"] = "Mes commandes";
}

<div class="page-container py-5">
    <div class="page-header">
        <h1>Mes commandes</h1>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <p>Vous n'avez aucune commande pour l'instant.</p>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary mt-2">Parcourir le catalogue</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-clean align-middle">
                <thead>
                    <tr>
                        <th>Commande</th>
                        <th>Date</th>
                        <th>Statut</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="text-muted small text-break">@order.Id</td>
                            <td>@order.CreatedAtUtc.ToString("dd/MM/yyyy")</td>
                            <td><span class="status-badge @OrderStatusPresentation.CssClass(order.Status)">@OrderStatusPresentation.Label(order.Status)</span></td>
                            <td class="fw-semibold">@order.Total.ToString("C")</td>
                            <td class="text-end"><a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">Détails</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
