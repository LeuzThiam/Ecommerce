@model IReadOnlyList<CategoryDto>
@{
    ViewData["Title"] = "Catégories";
}

<div class="page-container py-5">
    <div class="page-header">
        <h1>Catégories</h1>
        <p>@Model.Count catégorie@(Model.Count > 1 ? "s" : "")</p>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <p>Aucune catégorie pour l'instant.</p>
        </div>
    }
    else
    {
        <div class="row g-3 row-cols-2 row-cols-md-3 row-cols-lg-4">
            @foreach (var category in Model)
            {
                <div class="col">
                    <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@category.Id" class="product-card text-decoration-none">
                        <div class="product-card__media" style="font-size: 1.75rem;">
                            @category.Name.Substring(0, 1).ToUpperInvariant()
                        </div>
                        <div class="product-card__body">
                            <span class="product-card__name">@category.Name</span>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>
