@model PagedResult<ProductDto>
@{
    ViewData["Title"] = "Catalogue";
    var categories = (IReadOnlyList<CategoryDto>)ViewBag.Categories;
}

<h1>Catalogue</h1>

<form asp-controller="Catalog" asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-auto">
        <input type="text" name="query" value="@ViewBag.Query" class="form-control" placeholder="Rechercher un produit" />
    </div>
    <div class="col-auto">
        <select name="categoryId" class="form-select">
            <option value="">Toutes les catégories</option>
            @foreach (var category in categories)
            {
                <option value="@category.Id" selected="@(ViewBag.CategoryId == category.Id)">@category.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filtrer</button>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <p>Aucun produit ne correspond à votre recherche.</p>
}
else
{
    <div class="row">
        @foreach (var product in Model.Items)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text">@product.Price.ToString("C")</p>
                        <p class="card-text text-muted">
                            @(product.Stock > 0 ? $"{product.Stock} en stock" : "Rupture de stock")
                        </p>
                        <a asp-controller="Catalog" asp-action="Product" asp-route-slug="@product.Slug" class="btn btn-outline-primary">
                            Voir le produit
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <nav aria-label="Pagination du catalogue">
        <ul class="pagination">
            @if (Model.Page > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="Catalog" asp-action="Index"
                       asp-route-query="@ViewBag.Query" asp-route-categoryId="@ViewBag.CategoryId" asp-route-page="@(Model.Page - 1)">Précédent</a>
                </li>
            }
            @if (Model.Page < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="Catalog" asp-action="Index"
                       asp-route-query="@ViewBag.Query" asp-route-categoryId="@ViewBag.CategoryId" asp-route-page="@(Model.Page + 1)">Suivant</a>
                </li>
            }
        </ul>
    </nav>
}
