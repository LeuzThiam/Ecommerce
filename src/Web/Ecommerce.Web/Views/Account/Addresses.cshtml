@model IReadOnlyList<AddressDto>
@{
    ViewData["Title"] = "Mes adresses";
}

<div class="page-container py-5">
    <div class="page-header">
        <h1>Mes adresses</h1>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }

    <div class="row g-4">
        <div class="col-lg-6">
            @if (Model.Count == 0)
            {
                <div class="empty-state mb-4">
                    <p>Aucune adresse enregistrée.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-2 mb-4">
                    @foreach (var address in Model)
                    {
                        <div class="form-card d-flex justify-content-between align-items-start" style="max-width: none;">
                            <div>
                                @address.Line1@(string.IsNullOrWhiteSpace(address.Line2) ? "" : $", {address.Line2}")<br />
                                <span class="text-muted">@address.PostalCode @address.City, @address.Country</span>
                            </div>
                            @if (address.IsDefault)
                            {
                                <span class="status-badge status-badge--active">Par défaut</span>
                            }
                        </div>
                    }
                </div>
            }

            <h2 class="h5 mb-3">Ajouter une adresse</h2>
            <div class="form-card" style="max-width: none;">
                <form asp-controller="Account" asp-action="AddAddress" method="post">
                    <div class="mb-3">
                        <label class="form-label">Ligne 1</label>
                        <input type="text" name="line1" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ligne 2 (optionnel)</label>
                        <input type="text" name="line2" class="form-control" />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-7">
                            <label class="form-label">Ville</label>
                            <input type="text" name="city" class="form-control" required />
                        </div>
                        <div class="col-5">
                            <label class="form-label">Code postal</label>
                            <input type="text" name="postalCode" class="form-control" required />
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Pays</label>
                        <input type="text" name="country" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary">Ajouter</button>
                </form>
            </div>
        </div>
    </div>
</div>
