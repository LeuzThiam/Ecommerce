@model UserDto
@{
    ViewData["Title"] = "Mon profil";
}

<h1>Mon profil</h1>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<dl class="row">
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>
</dl>

<form method="post" class="col-md-4">
    <div class="mb-3">
        <label class="form-label">Nom affiché</label>
        <input type="text" name="displayName" class="form-control" value="@Model.DisplayName" required />
    </div>
    <button type="submit" class="btn btn-primary">Enregistrer</button>
</form>

<p class="mt-3">
    <a asp-controller="Account" asp-action="Addresses">Mes adresses</a>
    ·
    <a asp-controller="Orders" asp-action="Index">Mes commandes</a>
</p>
