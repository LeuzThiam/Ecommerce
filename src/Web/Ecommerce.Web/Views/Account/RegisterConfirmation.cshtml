@{
    ViewData["Title"] = "Vérifiez votre email";
}

<div class="page-container py-5 d-flex justify-content-center">
    <div class="form-card w-100 text-center">
        <h1 class="h3 mb-3">Vérifiez votre boîte mail</h1>
        <p class="text-muted mb-4">
            Votre compte a été créé. Un email de confirmation vient de vous être envoyé — cliquez sur le lien
            qu'il contient pour activer votre compte, puis connectez-vous.
        </p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Aller à la connexion</a>
    </div>
</div>
