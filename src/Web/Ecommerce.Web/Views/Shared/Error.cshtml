@model ErrorViewModel
@{
    ViewData["Title"] = "Erreur";
}

<div class="page-container py-5" style="max-width: 560px;">
    <div class="empty-state">
        <span class="status-badge status-badge--cancelled mb-3 d-inline-flex">Erreur</span>
        <h1 class="h3 mb-2">Une erreur est survenue</h1>
        <p class="mb-4">Désolé, le traitement de votre demande a échoué.</p>

        @if (Model.ShowRequestId)
        {
            <p class="small text-muted">Identifiant de requête : <code>@Model.RequestId</code></p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">Retour à l'accueil</a>
    </div>
</div>
