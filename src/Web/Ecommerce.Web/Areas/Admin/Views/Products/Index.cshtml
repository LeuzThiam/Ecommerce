@model PagedResult<ProductDto>
@{
    ViewData["Title"] = "Administration - Produits";
}

<h1>Produits</h1>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<p><a asp-area="Admin" asp-controller="Products" asp-action="Create" class="btn btn-primary">Nouveau produit</a></p>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="query" value="@ViewBag.Query" class="form-control" placeholder="Rechercher..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrer</button>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Prix</th>
            <th>Stock</th>
            <th>Statut</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model.Items)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Price.ToString("C")</td>
                <td>@product.Stock</td>
                <td>
                    @if (product.IsActive)
                    {
                        <span class="badge bg-success">Actif</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Désactivé</span>
                    }
                </td>
                <td class="d-flex gap-2">
                    <a asp-area="Admin" asp-controller="Products" asp-action="Edit" asp-route-id="@product.Id">Modifier</a>
                    @if (product.IsActive)
                    {
                        <form asp-area="Admin" asp-controller="Products" asp-action="Deactivate" asp-route-id="@product.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Désactiver</button>
                        </form>
                    }
                    else
                    {
                        <form asp-area="Admin" asp-controller="Products" asp-action="Activate" asp-route-id="@product.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-success">Réactiver</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
