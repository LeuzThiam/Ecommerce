@model PagedResult<ProductDto>
@{
    ViewData["Title"] = "Administration - Produits";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <h1 class="mb-0">Produits</h1>
    <a asp-area="Admin" asp-controller="Products" asp-action="Create" class="btn btn-primary">Nouveau produit</a>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-auto">
        <input type="text" name="query" value="@ViewBag.Query" class="form-control" placeholder="Rechercher..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filtrer</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-clean align-middle">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Prix</th>
                <th>Stock</th>
                <th>Statut</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Items)
            {
                <tr>
                    <td class="fw-medium">@product.Name</td>
                    <td>@product.Price.ToString("C")</td>
                    <td>@product.Stock</td>
                    <td>
                        @if (product.IsActive)
                        {
                            <span class="status-badge status-badge--active">Actif</span>
                        }
                        else
                        {
                            <span class="status-badge status-badge--inactive">Désactivé</span>
                        }
                    </td>
                    <td class="text-end">
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-area="Admin" asp-controller="Products" asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Modifier</a>
                            @if (product.IsActive)
                            {
                                <form asp-area="Admin" asp-controller="Products" asp-action="Deactivate" asp-route-id="@product.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Désactiver</button>
                                </form>
                            }
                            else
                            {
                                <form asp-area="Admin" asp-controller="Products" asp-action="Activate" asp-route-id="@product.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Réactiver</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
