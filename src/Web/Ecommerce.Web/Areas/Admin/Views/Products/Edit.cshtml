@model ProductDto
@{
    ViewData["Title"] = "Modifier le produit";
}

<h1>Modifier le produit</h1>

<div asp-validation-summary="All" class="text-danger"></div>

<form method="post" class="col-md-4">
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="mb-3">
        <label class="form-label">Nom</label>
        <input type="text" name="name" class="form-control" value="@Model.Name" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Prix</label>
        <input type="number" step="0.01" name="price" class="form-control" value="@Model.Price" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Stock</label>
        <input type="number" name="stock" class="form-control" value="@Model.Stock" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Catégorie</label>
        <select name="categoryId" class="form-select" required>
            @foreach (var category in (IReadOnlyList<CategoryDto>)ViewBag.Categories)
            {
                <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">@category.Name</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Enregistrer</button>
</form>
