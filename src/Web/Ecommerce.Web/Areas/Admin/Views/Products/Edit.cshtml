@model ProductDto
@{
    ViewData["Title"] = "Modifier le produit";
}

<div class="page-container py-5">
    <div class="page-header">
        <span class="section-label">Administration</span>
        <h1>Modifier le produit</h1>
    </div>

    @await Html.PartialAsync("_AdminNav")

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="form-card" style="max-width: none;">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <form method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">Nom</label>
                        <input type="text" name="name" class="form-control" value="@Model.Name" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Prix</label>
                        <input type="number" step="0.01" name="price" class="form-control" value="@Model.Price" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Stock</label>
                        <input type="number" name="stock" class="form-control" value="@Model.Stock" required />
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Catégorie</label>
                        <select name="categoryId" class="form-select" required>
                            @foreach (var category in (IReadOnlyList<CategoryDto>)ViewBag.Categories)
                            {
                                <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">@category.Name</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Enregistrer</button>
                </form>
            </div>
        </div>

        @if (Model.Variants is { Count: > 0 })
        {
            <div class="col-lg-6">
                <span class="section-label d-block mb-2">Variantes</span>
                <div class="table-responsive">
                    <table class="table table-clean align-middle">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Prix</th>
                                <th>Stock</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var variant in Model.Variants)
                            {
                                <tr>
                                    <td>@variant.Name</td>
                                    <td>@variant.Price.ToString("C")</td>
                                    <td>@variant.Stock</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
