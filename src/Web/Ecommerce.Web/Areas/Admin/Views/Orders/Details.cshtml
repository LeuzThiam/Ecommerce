@model OrderDto
@{
    ViewData["Title"] = "Détail de la commande (admin)";
}

<a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="d-inline-block mb-4 small">&larr; Commandes</a>

<div class="d-flex flex-wrap justify-content-between align-items-start mb-4 gap-3">
    <div>
        <span class="section-label d-block mb-1">Commande</span>
        <h1 class="h3 mb-2 text-break">@Model.Id</h1>
        <span class="status-badge @OrderStatusPresentation.CssClass(Model.Status)">@OrderStatusPresentation.Label(Model.Status)</span>
        <span class="text-muted ms-2">@Model.CreatedAtUtc.ToString("dd MMMM yyyy")</span>
        <p class="text-muted small mt-2 mb-0">Client : @Model.CustomerId</p>
    </div>
    @if (Model.Status == "Paid")
    {
        <form asp-area="Admin" asp-controller="Orders" asp-action="Refund" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-outline-danger">Rembourser</button>
        </form>
    }
</div>

<div class="table-responsive mb-4">
    <table class="table table-clean align-middle">
        <thead>
            <tr>
                <th>Produit</th>
                <th>Prix unitaire</th>
                <th>Quantité</th>
                <th>Sous-total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td class="fw-medium">@item.ProductName</td>
                    <td>@item.UnitPrice.ToString("C")</td>
                    <td>@item.Quantity</td>
                    <td class="fw-semibold">@item.Subtotal.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-end mb-5">
    <div class="form-card" style="max-width: 280px;">
        <div class="d-flex justify-content-between">
            <span class="text-muted">Total</span>
            <span class="fs-5 fw-bold" style="font-family: var(--font-display);">@Model.Total.ToString("C")</span>
        </div>
    </div>
</div>

@if (Model.Payments is { Count: > 0 })
{
    <span class="section-label d-block mb-2">Historique des paiements</span>
    <div class="table-responsive">
        <table class="table table-clean align-middle">
            <thead>
                <tr>
                    <th>Statut</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payment in Model.Payments)
                {
                    <tr>
                        <td>@payment.Status</td>
                        <td>@payment.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
