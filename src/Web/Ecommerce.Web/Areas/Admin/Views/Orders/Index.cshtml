@model IReadOnlyList<OrderDto>
@{
    ViewData["Title"] = "Administration - Commandes";
}

<h1>Commandes</h1>

@if (Model.Count == 0)
{
    <p>Aucune commande pour l'instant.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Commande</th>
                <th>Client</th>
                <th>Date</th>
                <th>Statut</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>@order.CustomerId</td>
                    <td>@order.CreatedAtUtc.ToString("dd/MM/yyyy")</td>
                    <td>@order.Status</td>
                    <td>@order.Total.ToString("C")</td>
                    <td><a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">Détails</a></td>
                </tr>
            }
        </tbody>
    </table>
}
