       class="btn btn-sm @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "btn-primary" : "btn-outline-primary")">Produits</a>
    <a asp-area="Admin" asp-controller="Categories" asp-action="Index"
       class="btn btn-sm @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "btn-primary" : "btn-outline-primary")">Catégories</a>
    <a asp-area="Admin" asp-controller="Orders" asp-action="Index"
       class="btn btn-sm @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "btn-primary" : "btn-outline-primary")">Commandes</a>
