@{
    Layout = "_Layout";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<div class="page-container py-5">
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <span class="section-label d-block mb-3">Administration</span>
            <nav class="admin-sidebar-nav">
                <a asp-area="Admin" asp-controller="Overview" asp-action="Index"
                   class="@(currentController == "Overview" ? "active" : "")">Vue d'ensemble</a>
                <a asp-area="Admin" asp-controller="Products" asp-action="Index"
                   class="@(currentController == "Products" ? "active" : "")">Produits</a>
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index"
                   class="@(currentController == "Categories" ? "active" : "")">Catégories</a>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index"
                   class="@(currentController == "Orders" ? "active" : "")">Commandes</a>
                <a asp-area="Admin" asp-controller="Users" asp-action="Index"
                   class="@(currentController == "Users" ? "active" : "")">Utilisateurs</a>
            </nav>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="admin-sidebar-exit">Voir la boutique →</a>
        </aside>
        <div class="admin-content">
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success">@success</div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger">@error</div>
            }
            @RenderBody()
        </div>
    </div>
</div>
