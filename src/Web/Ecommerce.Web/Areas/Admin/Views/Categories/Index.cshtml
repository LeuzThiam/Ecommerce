@model IReadOnlyList<CategoryDto>
@{
    ViewData["Title"] = "Administration - Catégories";
}

<h1 class="mb-4">Catégories</h1>

<div class="row g-4">
    <div class="col-lg-6">
        @if (Model.Count == 0)
        {
            <div class="empty-state mb-4">
                <p>Aucune catégorie.</p>
            </div>
        }
        else
        {
            <div class="table-responsive mb-4">
                <table class="table table-clean align-middle">
                    <tbody>
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td class="fw-medium">@category.Name</td>
                                <td class="text-end">
                                    <a asp-area="Admin" asp-controller="Categories" asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary">Modifier</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <h2 class="h5 mb-3">Nouvelle catégorie</h2>
        <div class="form-card" style="max-width: none;">
            <form asp-area="Admin" asp-controller="Categories" asp-action="Create" method="post" class="d-flex gap-2">
                <input type="text" name="name" class="form-control" required />
                <button type="submit" class="btn btn-primary">Créer</button>
            </form>
        </div>
    </div>
</div>
