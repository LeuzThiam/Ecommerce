# Copier ce fichier en ".env" (ignoré par git) et renseigner de vraies valeurs avant de lancer
# "docker compose up". Aucune de ces variables n'a de valeur par défaut dans le code : les
# services refusent de démarrer si elles sont absentes.

# Mot de passe du compte "sa" du conteneur SQL Server. Doit respecter la politique de
# complexité SQL Server (8+ caractères, majuscule+minuscule+chiffre+caractère spécial).
MSSQL_SA_PASSWORD=

# Clé symétrique partagée pour signer/valider les JWT entre Identity.Api et Catalog.Api.
JWT_SECRET_KEY=

# Clés Stripe (mode test) utilisées par Ordering.Api pour les paiements.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
